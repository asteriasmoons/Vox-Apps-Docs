---
import DocsLayout from "../layouts/DocsLayout.astro";
import GradientDivider from "../components/GradientDivider.astro";
---

<DocsLayout
  title="Voxiverse Support"
  description="Report bugs, send beta feedback, request features, review submitted reports, and manage private support conversations across the Voxiverse ecosystem."
>
  <main class="support-page">
    <section class="hero">
      <p class="eyebrow">Voxiverse Support</p>

      <h1 class="hero-title">
        Send a report without leaving the app that needs help.
      </h1>

      <p class="hero-text">
        Every active Voxiverse app includes the same in-app reporting system for
        bug reports, beta feedback, and feature requests. Reports are sent
        directly to Voxiverse Support, saved in the Submitted area inside the
        app you used, and can become private report conversations when Voxiverse
        needs to follow up.
      </p>

      <div class="hero-actions" aria-label="Voxiverse support shortcuts">
        <a class="primary-button raised-button" href="#report-types">
          Explore Report Types
        </a>

        <a class="secondary-button raised-button" href="#submitted">
          See What Happens Next
        </a>
      </div>

      <div class="hero-visual" aria-label="Voxiverse report flow">
        <article class="hero-system-card">
          <span class="system-kicker">SHARED VOXIVERSE REPORT SYSTEM</span>
          <strong>One support flow across six Voxiverse apps</strong>
          <span>
            Use the same Report Center flow in Loomey, Lurelia, Lunixia,
            VoxTerm, Sterium, or Markly.
          </span>

          <div class="system-flow">
            <span>Describe</span>
            <span class="flow-line"></span>
            <span>Send</span>
            <span class="flow-line"></span>
            <span>Track</span>
            <span class="flow-line"></span>
            <span>Reply</span>
          </div>

          <div class="hero-support-details">
            <div class="hero-detail-card">
              <span class="status-dot"></span>
              <span>
                <b>Automatic diagnostics</b>
                <small
                  >App, version, build, device, iOS, locale &amp; time zone</small
                >
              </span>
            </div>

            <div class="hero-detail-card">
              <span class="message-pulse"></span>
              <span>
                <b>Private follow-up</b>
                <small
                  >Invitation, unread status, replies &amp; attachments</small
                >
              </span>
            </div>
          </div>
        </article>
      </div>

      <GradientDivider />
    </section>

    <section
      class="content-section ecosystem-section"
      id="ecosystem"
      aria-labelledby="ecosystem-title"
    >
      <div class="section-copy">
        <p class="eyebrow">One Support System, Six Apps</p>

        <h2 id="ecosystem-title">
          The reporting experience is shared across the entire Voxiverse
        </h2>

        <p>
          Loomey, Lurelia, Lunixia, VoxTerm, Sterium, and Markly all use the
          same core reporting flow. The app you submit from becomes part of the
          report context automatically, while Voxiverse Support receives
          everything through one connected system.
        </p>
      </div>

      <div
        class="ecosystem-map"
        aria-label="Six Voxiverse apps connected to one report system"
      >
        <div class="app-ring">
          <span class="app-node app-node-1">
            <span class="app-name">Loomey</span>
            <span class="report-type-pill">Bug Reports</span>
          </span>
          <span class="app-node app-node-2">Lurelia</span>
          <span class="app-node app-node-3">
            <span class="app-name">Lunixia</span>
            <span class="report-type-pill">Feature Requests</span>
          </span>
          <span class="app-node app-node-4">VoxTerm</span>
          <span class="app-node app-node-5">
            <span class="app-name">Sterium</span>
            <span class="report-type-pill">Beta Feedback</span>
          </span>
          <span class="app-node app-node-6">Markly</span>

          <div class="ecosystem-center">
            <span>VOXIVERSE</span>
            <strong>Report Center</strong>
            <small>One connected support system</small>
          </div>
        </div>

        <div class="ecosystem-caption-grid">
          <article>
            <img
              class="ecosystem-card-icon"
              src="/img/icons/sparkle.svg"
              alt=""
              aria-hidden="true"
            />
            <strong>Same core forms</strong>
            <span
              >Each app uses the same support categories and submission flow.</span
            >
          </article>

          <article>
            <img
              class="ecosystem-card-icon"
              src="/img/icons/sparkle.svg"
              alt=""
              aria-hidden="true"
            />
            <strong>App-aware context</strong>
            <span
              >The originating app is carried with the report automatically.</span
            >
          </article>

          <article>
            <img
              class="ecosystem-card-icon"
              src="/img/icons/sparkle.svg"
              alt=""
              aria-hidden="true"
            />
            <strong>One support destination</strong>
            <span
              >Submissions flow into Voxiverse Support for review and follow-up.</span
            >
          </article>
        </div>
      </div>
    </section>

    <GradientDivider />

    <section
      class="content-section"
      id="report-types"
      aria-labelledby="report-types-title"
    >
      <div class="section-copy">
        <p class="eyebrow">Choose the Right Report</p>

        <h2 id="report-types-title">
          Three report types, shared across the Voxiverse
        </h2>

        <p>
          Voxiverse does not squeeze every support request into one generic
          form. The shared Report Center separates problems, testing feedback,
          and feature ideas so every app can collect the information Voxiverse
          Support actually needs to understand the submission.
        </p>
      </div>

      <div class="report-card-grid">
        <article class="report-card report-card-bug">
          <div class="card-glow"></div>

          <div class="report-icon" aria-hidden="true">
            <img src="/img/icons/bug.svg" alt="" />
          </div>

          <div class="report-card-copy">
            <span class="report-kicker">BUG REPORT</span>
            <h3>Something went wrong</h3>
            <p>
              Use this when a Voxiverse app behaves incorrectly, crashes, shows
              the wrong result, or fails to do what you expected.
            </p>
          </div>

          <div class="report-facts">
            <span>Area</span>
            <span>Severity</span>
            <span>Frequency</span>
            <span>Expected Behavior</span>
            <span>Steps to Reproduce</span>
          </div>

          <div class="card-footer">
            <span>Up to 3 screenshots</span>
            <span class="mini-arrow">→</span>
          </div>
        </article>

        <article class="report-card report-card-beta">
          <div class="card-glow"></div>

          <div class="report-icon" aria-hidden="true">
            <img src="/img/icons/feedback.svg" alt="" />
          </div>

          <div class="report-card-copy">
            <span class="report-kicker">BETA FEEDBACK</span>
            <h3>Tell us how testing felt</h3>
            <p>
              Use this for beta testing observations that may not be bugs:
              strengths, rough edges, confusing flows, incomplete areas, or
              unexpected behavior worth discussing.
            </p>
          </div>

          <div class="report-facts">
            <span>Area</span>
            <span>Overall Experience</span>
            <span>What You Tested</span>
            <span>What Worked Well</span>
            <span>What Could Be Better</span>
          </div>

          <div class="card-footer">
            <span>Unexpected behavior + extra thoughts</span>
            <span class="mini-arrow">→</span>
          </div>
        </article>

        <article class="report-card report-card-feature">
          <div class="card-glow"></div>

          <div class="report-icon" aria-hidden="true">
            <img src="/img/icons/bulb.svg" alt="" />
          </div>

          <div class="report-card-copy">
            <span class="report-kicker">FEATURE REQUEST</span>
            <h3>Describe what a Voxiverse app should do next</h3>
            <p>
              Feature requests collect more than a title. They ask what the
              feature should do, how you imagine using it, where it belongs, who
              it is for, and what problem it would solve.
            </p>
          </div>

          <div class="report-facts">
            <span>Feature Type</span>
            <span>Importance</span>
            <span>Audience</span>
            <span>Desired Location</span>
            <span>Requirements</span>
          </div>

          <div class="card-footer">
            <span>Saved data, notifications, sharing &amp; AI</span>
            <span class="mini-arrow">→</span>
          </div>
        </article>
      </div>
    </section>

    <GradientDivider />

    <section
      class="content-section"
      id="diagnostics"
      aria-labelledby="diagnostics-title"
    >
      <div class="section-copy">
        <p class="eyebrow">Less Repeating Yourself</p>

        <h2 id="diagnostics-title">
          Your Voxiverse app attaches technical context automatically
        </h2>

        <p>
          Every report type includes automatic diagnostics so you do not have to
          manually hunt down basic app and device information before asking for
          help, no matter which Voxiverse app you are reporting from.
        </p>
      </div>

      <div class="diagnostic-board">
        <article class="diagnostic-core">
          <span class="pulse-ring pulse-ring-one"></span>
          <span class="pulse-ring pulse-ring-two"></span>

          <div class="diagnostic-center">
            <span>AUTO</span>
            <strong>Diagnostics</strong>
          </div>
        </article>

        <div
          class="diagnostic-items"
          aria-label="Automatically attached diagnostics"
        >
          <article class="diagnostic-item">
            <span class="diagnostic-number">01</span>
            <strong>App version</strong>
            <span>The Voxiverse app version you submitted from.</span>
          </article>

          <article class="diagnostic-item">
            <span class="diagnostic-number">02</span>
            <strong>Build number</strong>
            <span>The exact installed build.</span>
          </article>

          <article class="diagnostic-item">
            <span class="diagnostic-number">03</span>
            <strong>Device &amp; iOS</strong>
            <span>Your hardware model and system version.</span>
          </article>

          <article class="diagnostic-item">
            <span class="diagnostic-number">04</span>
            <strong>Locale &amp; time zone</strong>
            <span>Useful context for regional and time-based problems.</span>
          </article>

          <article class="diagnostic-item">
            <span class="diagnostic-number">05</span>
            <strong>Screen context</strong>
            <span>Where the report was submitted from.</span>
          </article>

          <article class="diagnostic-item">
            <span class="diagnostic-number">06</span>
            <strong>Submission time</strong>
            <span>Attached with the report automatically.</span>
          </article>
        </div>
      </div>
    </section>

    <GradientDivider />

    <section
      class="content-section"
      id="submitted"
      aria-labelledby="submitted-title"
    >
      <div class="section-copy">
        <p class="eyebrow">After You Submit</p>

        <h2 id="submitted-title">
          Your report stays visible inside the app you submitted it from
        </h2>

        <p>
          Sent reports are stored in the Submitted area inside the Voxiverse app
          you used to send them. Each card keeps the report title, type,
          submission time, report ID, attachment indicator, and any
          private-conversation status that becomes available.
        </p>
      </div>

      <div class="submitted-showcase">
        <article class="submitted-card sample-one">
          <img src="/img/icons/bug.svg" alt="" />
          <strong>Book page freezes after editing notes</strong>
          <span>Bug Report</span>
          <code>LUM-8F31A2C4</code>
          <div class="submitted-status">
            <span class="status-badge status-new">Submitted</span>
          </div>
        </article>

        <article class="submitted-card sample-two">
          <div class="submitted-icon">
            <img src="/img/icons/feedback.svg" alt="" />
          </div>
          <strong>Testing the redesigned reading stats</strong>
          <span>Beta Feedback</span>
          <code>LUM-4D12E9AF</code>
          <div class="submitted-status">
            <span class="status-badge status-invite">
              <span class="tiny-live-dot"></span>
              Invite waiting
            </span>
          </div>
        </article>

        <article class="submitted-card sample-three">
          <img src="/img/icons/bulb.svg" alt="" />
          <strong>Custom reading-session templates</strong>
          <span>Feature Request</span>
          <code>LUM-2B77CC10</code>
          <div class="submitted-status">
            <span class="status-badge status-unread">
              <span class="tiny-live-dot"></span>
              2 unread
            </span>
          </div>
        </article>
      </div>

      <div class="flow-strip" aria-label="Submitted report lifecycle">
        <div class="flow-step">
          <span class="flow-step-number">1</span>
          <strong>Submitted</strong>
          <span>Your report is sent to Voxiverse and saved locally.</span>
        </div>

        <div class="flow-connector">
          <span></span>
        </div>

        <div class="flow-step">
          <span class="flow-step-number">2</span>
          <strong>Reviewed</strong>
          <span>Voxiverse can review the full report and attached context.</span
          >
        </div>

        <div class="flow-connector">
          <span></span>
        </div>

        <div class="flow-step">
          <span class="flow-step-number">3</span>
          <strong>Follow-up if needed</strong>
          <span
            >A private conversation invitation may appear on that report.</span
          >
        </div>
      </div>
    </section>

    <GradientDivider />

    <section
      class="content-section"
      id="conversation"
      aria-labelledby="conversation-title"
    >
      <div class="section-copy">
        <p class="eyebrow">Private Report Conversations</p>

        <h2 id="conversation-title">
          Voxiverse can invite you into a private thread attached to one report
        </h2>

        <p>
          Private report conversations are not open community chats. They stay
          tied to the specific report and originating app that need follow-up,
          and you choose whether to accept the invitation.
        </p>
      </div>

      <div class="conversation-stage">
        <div class="conversation-thread">
          <div class="conversation-header">
            <span class="conversation-lock">PRIVATE</span>
            <strong>Report conversation</strong>
            <span>LUM-4D12E9AF</span>
          </div>

          <div class="message-row staff-row">
            <div class="message-bubble staff-message">
              <span class="message-author">Voxiverse</span>
              <p>
                We would like a little more detail about what happened when you
                opened this screen.
              </p>
              <small>10:24 AM</small>
            </div>
          </div>

          <div class="message-row user-row">
            <div class="message-bubble user-message">
              <span class="message-author">You</span>
              <p>
                Absolutely. It happens after I edit the note, return to the
                book, and open Stats.
              </p>
              <small>10:27 AM</small>
            </div>
          </div>

          <div class="typing-card" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </div>

        <aside class="conversation-controls">
          <article class="control-card">
            <span class="control-number">01</span>
            <strong>Invitation first</strong>
            <p>
              If Voxiverse wants to discuss a report privately, Loomey shows an
              invitation and first message.
            </p>
          </article>

          <article class="control-card">
            <span class="control-number">02</span>
            <strong>You choose</strong>
            <p>
              Accept to reply in the thread, or decline to close the invitation
              on your side.
            </p>
          </article>

          <article class="control-card">
            <span class="control-number">03</span>
            <strong>Attachments supported</strong>
            <p>
              Messages can include attachments, and failed outgoing messages can
              be retried.
            </p>
          </article>

          <article class="control-card">
            <span class="control-number">04</span>
            <strong>Replies can be paused</strong>
            <p>
              A conversation may become read-only temporarily while still
              remaining available for you to review.
            </p>
          </article>
        </aside>
      </div>
    </section>

    <GradientDivider />

    <section class="content-section" id="how-to" aria-labelledby="how-to-title">
      <div class="section-copy">
        <p class="eyebrow">How to Use Support</p>

        <h2 id="how-to-title">
          The shortest path from problem to useful report
        </h2>
      </div>

      <div class="steps-timeline">
        <article class="timeline-card">
          <span class="timeline-marker">1</span>
          <div>
            <strong>Open Settings</strong>
            <p>
              Open Settings in the Voxiverse app you are using and choose <b
                >Send a Report</b
              >.
            </p>
          </div>
        </article>

        <article class="timeline-card">
          <span class="timeline-marker">2</span>
          <div>
            <strong>Choose the report type</strong>
            <p>
              Use Bug Report for broken behavior, Beta Feedback for testing
              observations, or Feature Request for something you want added.
            </p>
          </div>
        </article>

        <article class="timeline-card">
          <span class="timeline-marker">3</span>
          <div>
            <strong>Give enough context</strong>
            <p>
              Fill the form as specifically as you can. Attach screenshots or
              reference images when they make the situation easier to
              understand.
            </p>
          </div>
        </article>

        <article class="timeline-card">
          <span class="timeline-marker">4</span>
          <div>
            <strong>Check Submitted later</strong>
            <p>
              Your report ID and details remain available there, along with any
              private-conversation invitation or unread-message indicator.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="footer-note" aria-label="Voxiverse support note">
      <div class="footer-glow"></div>

      <p class="eyebrow">Voxiverse Support</p>

      <h2>Support starts inside the Voxiverse app you are already using.</h2>

      <p>
        The in-app Report Center is the primary way to send bug reports, beta
        feedback, and feature requests across Voxiverse because it keeps the
        right fields, diagnostics, attachments, report history, originating app,
        and follow-up conversation attached to the same submission.
      </p>

      <a class="primary-button raised-button footer-button" href="/contact">
        Contact Voxiverse Support
      </a>
    </section>
  </main>
</DocsLayout>

<style>
  .support-page {
    width: 100%;
    max-width: 100%;
    margin: -1.25rem auto -1.25rem;
    padding: 0;
    overflow-x: hidden;
  }

  .hero {
    position: relative;
    padding: 0;
  }

  .eyebrow {
    margin-bottom: 1rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .hero-title {
    max-width: 900px;
    margin-bottom: 1rem;
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .hero-text {
    max-width: 790px;
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.8rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-bg);
    text-decoration: none;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .primary-button {
    background: var(--accent-periwinkle);
  }

  .secondary-button {
    background: var(--surface-raised) !important;
    color: var(--color-text) !important;
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-2px);
    border-color: var(--accent-periwinkle);
  }

  .content-section {
    width: min(100%, 1100px);
    margin: 0 auto;
    padding: 0.5rem 0;
  }

  .section-copy {
    max-width: 850px;
    margin-bottom: 1.5rem;
  }

  .section-copy h2,
  .footer-note h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.7rem, 3vw, 2.45rem);
    line-height: 1.12;
  }

  .section-copy p {
    max-width: 800px;
  }

  .hero-visual {
    position: relative;
    min-height: 360px;
    margin: 0 0 1rem;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .hero-orbit {
    position: absolute;
    border: 1px solid
      color-mix(in srgb, var(--accent-periwinkle) 34%, transparent);
    border-radius: 50%;
    pointer-events: none;
    animation: orbit-pulse 5.6s ease-in-out infinite;
  }

  .hero-orbit-one {
    width: 310px;
    height: 310px;
  }

  .hero-orbit-two {
    width: 420px;
    height: 420px;
    opacity: 0.44;
    animation-delay: -2.2s;
  }

  .hero-system-card {
    position: relative;
    z-index: 2;
    width: min(100%, 660px);
    padding: 1.6rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 28px;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.04),
        rgba(255, 255, 255, 0)
      ),
      var(--surface-raised);
    box-shadow: var(--glass-shadow);
    overflow: hidden;
    animation: float-card 6s ease-in-out infinite;
  }

  .hero-system-card::before {
    content: "";
    position: absolute;
    inset: -45% auto auto -10%;
    width: 55%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent-periwinkle);
    opacity: 0.09;
    filter: blur(40px);
    pointer-events: none;
  }

  .system-kicker {
    display: block;
    margin-bottom: 0.7rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .hero-system-card > strong {
    display: block;
    margin-bottom: 0.55rem;
    font-size: clamp(1.35rem, 3vw, 2rem);
    color: var(--heading-small);
  }

  .hero-system-card > span:not(.system-kicker) {
    color: var(--text-muted);
  }

  .system-flow {
    display: grid;
    grid-template-columns:
      auto minmax(22px, 1fr) auto minmax(22px, 1fr)
      auto minmax(22px, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }

  .system-flow > span:not(.flow-line) {
    display: inline-flex;
    justify-content: center;
    padding: 0.55rem 0.72rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--surface-standard);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .flow-line {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent-periwinkle),
      transparent
    );
    animation: line-shimmer 2.8s linear infinite;
  }

  .floating-status-card {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: min(82%, 310px);
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--surface-standard);
    box-shadow: var(--glass-shadow-soft);
    backdrop-filter: blur(16px);
  }

  .floating-status-one {
    top: 10%;
    right: 3%;
    animation: drift-one 7s ease-in-out infinite;
  }

  .floating-status-two {
    bottom: 6%;
    left: 2%;
    animation: drift-two 8s ease-in-out infinite;
  }

  .floating-status-card b,
  .floating-status-card small {
    display: block;
  }

  .floating-status-card b {
    margin-bottom: 0.15rem;
    color: var(--heading-small);
  }

  .floating-status-card small {
    color: var(--text-muted);
    line-height: 1.35;
  }

  .status-dot,
  .message-pulse {
    position: relative;
    flex: 0 0 auto;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--accent-periwinkle);
    box-shadow: 0 0 0 0
      color-mix(in srgb, var(--accent-periwinkle) 38%, transparent);
    animation: status-pulse 2s infinite;
  }

  .message-pulse {
    background: var(--heading-small);
  }

  .report-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .report-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 430px;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 26px;
    background: var(--surface-standard);
    box-shadow: var(--glass-shadow-soft);
    overflow: hidden;
    transform-style: preserve-3d;
    transition:
      transform 0.28s ease,
      border-color 0.28s ease,
      background 0.28s ease;
  }

  .report-card:hover {
    transform: translateY(-7px) rotateX(1.2deg) rotateY(-1.2deg);
    border-color: var(--accent-periwinkle);
    background: var(--surface-raised);
  }

  .card-glow {
    position: absolute;
    width: 180px;
    height: 180px;
    top: -70px;
    right: -50px;
    border-radius: 50%;
    background: var(--accent-periwinkle);
    filter: blur(50px);
    opacity: 0.09;
    transition:
      opacity 0.28s ease,
      transform 0.28s ease;
  }

  .report-card:hover .card-glow {
    opacity: 0.18;
    transform: scale(1.12);
  }

  .report-icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin-bottom: 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 18px;
    background: var(--surface-raised);
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--heading-small);
    transition: transform 0.28s ease;
  }

  .report-card:hover .report-icon {
    transform: translateY(-2px) rotate(-4deg) scale(1.05);
  }

  .report-kicker {
    display: block;
    margin-bottom: 0.55rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .report-card h3 {
    margin: 0 0 0.7rem;
    font-size: 1.3rem;
  }

  .report-card p {
    color: var(--text-muted);
  }

  .report-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .report-facts span {
    padding: 0.45rem 0.62rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--surface-raised);
    font-size: 0.76rem;
    color: var(--heading-small);
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .mini-arrow {
    color: var(--heading-small);
    transition: transform 0.2s ease;
  }

  .report-card:hover .mini-arrow {
    transform: translateX(5px);
  }

  .diagnostic-board {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 1.1rem;
    align-items: stretch;
  }

  .diagnostic-core {
    position: relative;
    min-height: 310px;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 28px;
    background: var(--surface-raised);
    overflow: hidden;
  }

  .diagnostic-center {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 138px;
    height: 138px;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--surface-standard);
    box-shadow: var(--glass-shadow-soft);
  }

  .diagnostic-center span,
  .diagnostic-center strong {
    display: block;
    text-align: center;
  }

  .diagnostic-center span {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--text-muted);
  }

  .diagnostic-center strong {
    color: var(--heading-small);
  }

  .pulse-ring {
    position: absolute;
    width: 170px;
    height: 170px;
    border: 1px solid var(--accent-periwinkle);
    border-radius: 50%;
    opacity: 0;
    animation: radar-ring 3.2s ease-out infinite;
  }

  .pulse-ring-two {
    animation-delay: 1.6s;
  }

  .diagnostic-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .diagnostic-item {
    position: relative;
    min-height: 140px;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--surface-standard);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .diagnostic-item:hover {
    transform: translateY(-3px);
    border-color: var(--accent-periwinkle);
  }

  .diagnostic-number {
    display: block;
    margin-bottom: 1rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .diagnostic-item strong,
  .diagnostic-item span:last-child {
    display: block;
  }

  .diagnostic-item strong {
    margin-bottom: 0.35rem;
    color: var(--heading-small);
  }

  .diagnostic-item span:last-child {
    color: var(--text-muted);
    font-size: 0.86rem;
  }

  .submitted-showcase {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    perspective: 1000px;
  }

  .submitted-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 245px;
    padding: 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    background: var(--surface-standard);
    text-align: center;
    box-shadow: var(--glass-shadow-soft);
    transition:
      transform 0.28s ease,
      border-color 0.28s ease;
  }

  .submitted-card:hover {
    transform: translateY(-6px) rotateX(3deg);
    border-color: var(--accent-periwinkle);
  }

  .submitted-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--surface-raised);
    color: var(--heading-small);
    font-family: var(--font-heading);
    font-weight: 900;
  }

  .submitted-card strong {
    min-height: 2.8em;
    color: var(--heading-small);
  }

  .submitted-card > span:not(.submitted-status span) {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .submitted-card code {
    margin-top: 0.75rem;
    font-size: 0.73rem;
    color: var(--heading-small);
  }

  .submitted-status {
    margin-top: auto;
    padding-top: 1rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 30px;
    padding: 0.4rem 0.68rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--surface-raised);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .status-invite,
  .status-unread {
    color: var(--heading-small);
  }

  .tiny-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-periwinkle);
    animation: status-pulse 1.8s infinite;
  }

  .flow-strip {
    display: grid;
    grid-template-columns: 1fr 80px 1fr 80px 1fr;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .flow-step {
    min-height: 155px;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--surface-raised);
  }

  .flow-step-number {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    background: var(--accent-periwinkle);
    color: var(--color-bg);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .flow-step strong,
  .flow-step span:last-child {
    display: block;
  }

  .flow-step strong {
    margin-bottom: 0.4rem;
    color: var(--heading-small);
  }

  .flow-step span:last-child {
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .flow-connector span {
    display: block;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent-periwinkle),
      transparent
    );
    background-size: 200% 100%;
    animation: connector-flow 2.4s linear infinite;
  }

  .conversation-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
    gap: 1rem;
  }

  .conversation-thread {
    min-height: 520px;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 28px;
    background: var(--surface-standard);
    box-shadow: var(--glass-shadow-soft);
  }

  .conversation-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.3rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .conversation-lock {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .conversation-header strong {
    color: var(--heading-small);
  }

  .conversation-header > span:last-child {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .message-row {
    display: flex;
    margin: 1rem 0;
  }

  .user-row {
    justify-content: flex-end;
  }

  .message-bubble {
    max-width: 78%;
    padding: 0.95rem 1rem;
    border-radius: 20px;
    color: var(--color-text);
    animation: message-rise 0.55s ease both;
  }

  .staff-message {
    background: color-mix(
      in srgb,
      var(--accent-periwinkle) 26%,
      var(--surface-raised)
    );
    border-bottom-left-radius: 7px;
  }

  .user-message {
    background: var(--surface-raised);
    border: 1px solid var(--color-border-strong);
    border-bottom-right-radius: 7px;
    animation-delay: 0.18s;
  }

  .message-author,
  .message-bubble small {
    display: block;
  }

  .message-author {
    margin-bottom: 0.35rem;
    font-size: 0.72rem;
    font-weight: 900;
    color: var(--heading-small);
  }

  .message-bubble p {
    margin: 0;
  }

  .message-bubble small {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .typing-card {
    display: inline-flex;
    gap: 0.35rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--surface-raised);
  }

  .typing-card span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-muted);
    animation: typing 1.2s infinite ease-in-out;
  }

  .typing-card span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .typing-card span:nth-child(3) {
    animation-delay: 0.3s;
  }

  .conversation-controls {
    display: grid;
    gap: 0.8rem;
  }

  .control-card {
    position: relative;
    min-height: 118px;
    padding: 1rem 1rem 1rem 3.7rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--surface-standard);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .control-card:hover {
    transform: translateX(4px);
    border-color: var(--accent-periwinkle);
  }

  .control-number {
    position: absolute;
    left: 1rem;
    top: 1rem;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 12px;
    background: var(--surface-raised);
    color: var(--heading-small);
    font-size: 0.7rem;
    font-weight: 900;
  }

  .control-card strong {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--heading-small);
  }

  .control-card p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .steps-timeline {
    position: relative;
    display: grid;
    gap: 0.8rem;
  }

  .steps-timeline::before {
    content: "";
    position: absolute;
    left: 22px;
    top: 30px;
    bottom: 30px;
    width: 1px;
    background: linear-gradient(var(--accent-periwinkle), transparent);
  }

  .timeline-card {
    position: relative;
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--surface-standard);
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .timeline-card:hover {
    transform: translateX(5px);
    background: var(--surface-raised);
  }

  .timeline-marker {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--accent-periwinkle);
    color: var(--color-bg);
    font-family: var(--font-heading);
    font-weight: 900;
  }

  .timeline-card strong {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--heading-small);
  }

  .timeline-card p {
    margin: 0;
    color: var(--text-muted);
  }

  .footer-note {
    position: relative;
    width: min(100%, 1100px);
    margin: 0.75rem auto 0;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    background: var(--surface-standard);
    overflow: hidden;
  }

  .footer-glow {
    position: absolute;
    width: 260px;
    height: 260px;
    top: -140px;
    right: -80px;
    border-radius: 50%;
    background: var(--accent-periwinkle);
    opacity: 0.08;
    filter: blur(44px);
  }

  .footer-note p {
    position: relative;
    max-width: 800px;
  }

  .footer-button {
    position: relative;
    margin-top: 0.5rem;
  }

  @keyframes float-card {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  @keyframes orbit-pulse {
    0%,
    100% {
      transform: scale(0.94);
      opacity: 0.24;
    }
    50% {
      transform: scale(1.04);
      opacity: 0.55;
    }
  }

  @keyframes drift-one {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-8px, 7px);
    }
  }

  @keyframes drift-two {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(8px, -6px);
    }
  }

  @keyframes status-pulse {
    0% {
      box-shadow: 0 0 0 0
        color-mix(in srgb, var(--accent-periwinkle) 35%, transparent);
    }
    70% {
      box-shadow: 0 0 0 10px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  @keyframes line-shimmer {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 160px 0;
    }
  }

  @keyframes radar-ring {
    0% {
      transform: scale(0.65);
      opacity: 0.48;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  @keyframes connector-flow {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 200% 0;
    }
  }

  @keyframes message-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }

  .ecosystem-map {
    display: grid;
    grid-template-columns: minmax(320px, 0.95fr) minmax(300px, 1.05fr);
    gap: 1.2rem;
    align-items: center;
  }

  .app-ring {
    position: relative;
    min-height: 460px;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 30px;
    background:
      radial-gradient(
        circle at center,
        color-mix(in srgb, var(--accent-periwinkle) 10%, transparent),
        transparent 34%
      ),
      var(--surface-standard);
    overflow: hidden;
  }

  .app-ring::before,
  .app-ring::after {
    content: "";
    position: absolute;
    border: 1px solid
      color-mix(in srgb, var(--accent-periwinkle) 28%, transparent);
    border-radius: 50%;
    animation: ecosystem-ring 8s linear infinite;
  }

  .app-ring::before {
    width: 330px;
    height: 330px;
  }

  .app-ring::after {
    width: 240px;
    height: 240px;
    animation-direction: reverse;
    animation-duration: 6s;
  }

  .ecosystem-center {
    position: relative;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 190px;
    height: 190px;
    padding: 1.1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--surface-raised);
    box-shadow: var(--glass-shadow);
    text-align: center;
  }

  .ecosystem-center span {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .ecosystem-center strong {
    margin: 0.3rem 0;
    color: var(--heading-small);
    font-size: 1.2rem;
  }

  .ecosystem-center small {
    color: var(--text-muted);
    line-height: 1.35;
  }

  .app-node {
    position: absolute;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 96px;
    min-height: 40px;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--surface-raised);
    color: var(--heading-small);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 900;
    box-shadow: var(--glass-shadow-soft);
    animation: node-float 5s ease-in-out infinite;
  }

  .app-node-1 {
    top: 11%;
    left: 50%;
    transform: translateX(-50%);
    animation-delay: 0s;
  }
  .app-node-2 {
    top: 27%;
    right: 7%;
    animation-delay: -0.8s;
  }
  .app-node-3 {
    bottom: 24%;
    right: 7%;
    animation-delay: -1.6s;
  }
  .app-node-4 {
    bottom: 10%;
    left: 50%;
    transform: translateX(-50%);
    animation-delay: -2.4s;
  }
  .app-node-5 {
    bottom: 24%;
    left: 7%;
    animation-delay: -3.2s;
  }
  .app-node-6 {
    top: 27%;
    left: 7%;
    animation-delay: -4s;
  }

  .ecosystem-caption-grid {
    display: grid;
    gap: 0.9rem;
  }

  .ecosystem-caption-grid article {
    position: relative;
    min-height: 120px;
    padding: 1rem 1rem 1rem 3.8rem;
    border: 1px solid var(--color-border);
    border-radius: 22px;
    background: var(--surface-standard);
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      background 0.22s ease;
  }

  .ecosystem-caption-grid article:hover {
    transform: translateX(5px);
    border-color: var(--accent-periwinkle);
    background: var(--surface-raised);
  }

  .ecosystem-caption-grid article::before {
    content: "";
    position: absolute;
    left: 1rem;
    top: 1rem;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 12px;
    background: var(--surface-raised);
    color: var(--heading-small);
    border: 1px solid var(--color-border);
  }

  .ecosystem-caption-grid strong,
  .ecosystem-caption-grid span {
    display: block;
  }

  .ecosystem-caption-grid strong {
    margin-bottom: 0.35rem;
    color: var(--heading-small);
  }

  .ecosystem-caption-grid span {
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  @keyframes ecosystem-ring {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes node-float {
    0%,
    100% {
      margin-top: 0;
    }
    50% {
      margin-top: -6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .support-page *,
    .support-page *::before,
    .support-page *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
    }
  }

  @media (max-width: 980px) {
    .ecosystem-map {
      grid-template-columns: 1fr;
    }

    .report-card-grid,
    .submitted-showcase {
      grid-template-columns: 1fr;
    }

    .report-card {
      min-height: 0;
    }

    .diagnostic-board,
    .conversation-stage {
      grid-template-columns: 1fr;
    }

    .diagnostic-core {
      min-height: 240px;
    }

    .flow-strip {
