  .lunixia-gallery {
    position: relative;
    width: min(100%, 430px);
    margin: 0 auto;
    overflow: hidden;
    padding: 1rem 0 2.75rem;
    touch-action: pan-y;
  }

  .gallery-track-container {
    position: relative;
    overflow: hidden;
    border-radius: 32px;
  }

  .gallery-track {
    display: flex;
    align-items: center;
    will-change: transform;
    transition:
      transform 0.62s
      cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .gallery-slide {
    flex: 0 0 100%;
    margin: 0;
    opacity: 0.78;
    transition: opacity 0.35s ease;
  }

  .gallery-slide.is-active {
    opacity: 1;
  }

  .gallery-slide img {
    display: block;
    width: 100%;
