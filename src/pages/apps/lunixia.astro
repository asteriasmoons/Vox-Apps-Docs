  .intro-section {
    max-width: 850px;
    padding: 4rem 0 2rem;
  }

  .intro-section h2,
  .gallery-heading h2,
  .spotlight h2,
  .details-section h2,
  .community-banner h2,
  .cta-section h2 {
    margin: 0 0 1rem;
