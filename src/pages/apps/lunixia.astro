    .hero h1 {
      max-width: 840px;
      margin-bottom: 1rem;
      font-size: 4.15rem;
      line-height: 1;
      letter-spacing: 0;
    }

    .hero-text {
      max-width: 660px;
      font-size: 1rem;
    }

    .hero-actions {
      margin-top: 1.5rem;
    }

    .hero-showcase {
      align-self: center;
      justify-self: end;
      width: 100%;
      max-width: 380px;
      min-height: 430px;
    }

    .main-card {
