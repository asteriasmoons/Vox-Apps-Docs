      max-width: 660px;
      font-size: 1rem;
    }

    .hero-actions {
      margin-top: 1.5rem;
    }

    .hero-showcase {
      align-self: center;
      justify-self: end;
      width: 100%;
      max-width: 380px;
      min-height: 430px;
    }

    .main-card {
      inset: 58px 16px 104px 16px;
      padding: 1.45rem;
      border-radius: 26px;
      transform: none;
    }

    .main-card h4 {
      max-width: 320px;
      font-size: 2.35rem;
    }

    .progress-line {
      margin: 1.2rem 0;
    }

    .showcase-stats {
      gap: 0.65rem 0.9rem;
      font-size: 0.9rem;
    }

    .floating-card-one {
      top: 0;
      right: 0;
      max-width: 282px;
    }

    .floating-card-two {
      bottom: 16px;
      left: 0;
      max-width: 292px;
    }
  }

  @media (min-width: 901px) and (max-width: 1160px) {
    .hero {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(320px, 340px);
      gap: 2rem;
    }

    .hero h1 {
      font-size: 3.7rem;
    }

    .main-card h4 {
      font-size: 2.1rem;
    }
  }

  @media (min-width: 1400px) {
    .hero h1 {
      font-size: 4.75rem;
    }
  }

  .intro-section {
    max-width: 850px;
    padding: 4rem 0 2rem;
  }

  .intro-section h2,
  .gallery-heading h2,
  .spotlight h2,
  .details-section h2,
  .community-banner h2,
  .cta-section h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.05;
  }

  .lurelia-gallery-section {
    position: relative;
