    :global(.content:has(.lurelia-page)) {
      max-width: 1280px;
      padding-inline: clamp(1.5rem, 3vw, 3rem);
    }

    .hero {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(340px, 380px);
      gap: clamp(2rem, 3.5vw, 4rem);
      min-height: 610px;
      padding: 2.15rem 0 2.65rem;
    }

