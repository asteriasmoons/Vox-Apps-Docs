---
import DocsLayout from "../../layouts/DocsLayout.astro";
import GradientDivider from "../../components/GradientDivider.astro";

/*
const lureliaGalleryImages = [
  "IMG_0001.PNG",
  "IMG_0002.PNG",
  "IMG_0003.PNG",
  "IMG_0004.PNG",
  "IMG_0005.PNG",
  "IMG_0006.PNG",
  "IMG_0007.PNG",
  "IMG_0008.PNG",
].map((fileName, index) => ({
  alt: `Lurelia app screenshot ${index + 1}`,
  src: `/img/lurelia/${fileName}`,
}));
*/
---

<DocsLayout
  title="Lurelia"
  description="Build routines, track habits, manage reminders and events, organize your schedule, and follow meaningful journeys with Lurelia."
>
  <main class="lurelia-page">
    <section class="hero">
      <div class="hero-copy reveal">
        <p class="eyebrow">Meet Lurelia</p>

        <h1>Build your days with intention, structure, and room to actually live them.</h1>

        <p class="hero-text">
          Lurelia is a personal planning and routine companion built to bring the
          moving parts of everyday life together. Create detailed routines,
          build habits, manage reminders and events, organize your schedule
          visually, follow longer journeys, and keep the things you want to do
          connected instead of scattered across separate systems.
        </p>

        <div class="hero-actions" aria-label="Lurelia links">
          <a class="primary-button raised-button" href="#features">
            Explore Features
          </a>

          <a class="secondary-button raised-button" href="/contact">
            Contact Support
          </a>
        </div>
      </div>

      <div class="hero-showcase reveal reveal-delay">
        <div class="showcase-card main-card">
          <span class="mini-label">Your Day in Lurelia</span>

          <h4>Everything that matters, moving together.</h4>

          <div class="progress-line">
            <span></span>
          </div>

          <div class="showcase-stats">
            <span><b>4</b> routines</span>
            <span><b>7</b> habits</span>
            <span><b>5</b> reminders</span>
          </div>
        </div>

        <div class="floating-card floating-card-one">
          <span>Routine Active</span>
          <strong>Morning flow in progress</strong>
        </div>

        <div class="floating-card floating-card-two">
          <span>Today</span>
          <strong>Your timeline is ready</strong>
        </div>
      </div>
    </section>

    <GradientDivider />

    <section class="intro-section reveal">
      <p class="eyebrow">One Connected System</p>

      <h2>Your life does not happen in separate productivity apps.</h2>

      <p>
        Lurelia brings routines, habits, reminders, events, journeys, and schedule
        planning into one personal system. Instead of managing a collection of
        disconnected tasks, you can build structures around when things happen,
        how they fit together, and the progress you make over time.
      </p>
    </section>

