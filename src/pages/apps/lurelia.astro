<style>
  .lurelia-page {
    position: relative;
    width: 100%;
    padding: 1rem 0 5rem;
    overflow: hidden;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(310px, 0.8fr);
    align-items: center;
    gap: 3rem;
    min-height: 620px;
    padding: 4rem 0;
  }

  .hero-copy,
  .hero-showcase {
    position: relative;
    z-index: 2;
  }

  .hero h1 {
    max-width: 860px;
    margin: 0 0 1.25rem;
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.96;
    letter-spacing: -0.055em;
  }

  .eyebrow,
  .card-kicker,
  .mini-label {
    margin: 0 0 0.85rem;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero-text,
  .intro-section p,
  .spotlight p,
  .community-banner p,
  .cta-section > p {
    max-width: 760px;
    font-size: 1.06rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0.9rem 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-bg);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .primary-button {
    background: var(--accent-periwinkle);
  }

  .secondary-button {
    background: var(--surface-raised) !important;
    color: var(--color-text) !important;
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-3px);
    border-color: var(--accent-periwinkle);
  }

  .hero-showcase {
    min-height: 410px;
  }

  .showcase-card,
  .floating-card,
  .feature-card,
  .share-demo,
  .details-list details,
  .community-banner,
  .cta-card {
    border: 1px solid var(--color-border);
    background: var(--surface-standard);
    box-shadow: var(--glass-shadow-soft);
  }

  .main-card {
    position: absolute;
    inset: 55px 20px 55px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem;
    border-radius: 30px;
    transform: rotate(2deg);
  }

  .main-card h4 {
    max-width: 420px;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.05;
  }

  .progress-line {
    height: 10px;
    margin: 1.75rem 0;
    border-radius: 999px;
    background: var(--surface-raised);
    overflow: hidden;
  }

  .progress-line span {
    display: block;
    width: 72%;
