---
import DocsLayout from "../../layouts/DocsLayout.astro";
import GradientDivider from "../../components/GradientDivider.astro";

/*
const lureliaGalleryImages = [
  "IMG_0001.PNG",
  "IMG_0002.PNG",
  "IMG_0003.PNG",
  "IMG_0004.PNG",
  "IMG_0005.PNG",
  "IMG_0006.PNG",
  "IMG_0007.PNG",
  "IMG_0008.PNG",
].map((fileName, index) => ({
  alt: `Lurelia app screenshot ${index + 1}`,
  src: `/img/lurelia/${fileName}`,
}));
*/
---

<DocsLayout
  title="Lurelia"
  description="Build routines, track habits, manage reminders and events, organize your schedule, and create a life that works with you in Lurelia."
>
  <main class="lurelia-page">
    <section class="hero">
      <div class="hero-copy reveal">
        <p class="eyebrow">Meet Lurelia</p>

        <h1>Build your days with intention, structure, and room to actually live them.</h1>

        <p class="hero-text">
          Lurelia is a personal planning and routine companion built for the
          moving parts of everyday life. Create detailed routines, build habits,
          manage reminders and events, shape your schedule visually, follow
          longer journeys, and keep the things you want to do connected instead
          of scattered across separate systems.
        </p>

        <div class="hero-actions" aria-label="Lurelia links">
          <a class="primary-button raised-button" href="#features">
            Explore Features
          </a>

          <a class="secondary-button raised-button" href="/contact">
            Contact Support
          </a>
        </div>
      </div>

      <div class="hero-showcase reveal reveal-delay">
        <div class="showcase-card main-card">
          <span class="mini-label">Your Day in Lurelia</span>

          <h4>Everything that matters, moving together.</h4>

          <div class="progress-line">
            <span></span>
          </div>

          <div class="showcase-stats">
            <span><b>4</b> routines</span>
            <span><b>7</b> habits</span>
            <span><b>5</b> reminders</span>
          </div>
        </div>

        <div class="floating-card floating-card-one">
          <span>Routine Active</span>
          <strong>Morning flow in progress</strong>
        </div>

        <div class="floating-card floating-card-two">
          <span>Today</span>
          <strong>Your timeline is ready</strong>
        </div>
      </div>
    </section>

    <GradientDivider />

    <section class="intro-section reveal">
      <p class="eyebrow">One Connected System</p>

      <h2>Your life does not happen in separate productivity apps.</h2>

      <p>
        Lurelia brings routines, habits, reminders, events, journeys, and
        schedule planning into one personal system. Instead of managing a list
        of disconnected tasks, you can build structures around when things
        happen, why they matter, how they fit together, and what progress looks
        like over time.
      </p>
    </section>

    {/*
    <section
      class="lurelia-gallery-section reveal"
      aria-labelledby="lurelia-gallery-title"
    >
      <div class="section-heading gallery-heading">
        <p class="eyebrow">Inside Lurelia</p>

        <h2 id="lurelia-gallery-title">
          See your routines, habits, schedule, and progress come together
        </h2>
      </div>

      <div class="lurelia-gallery" data-lurelia-gallery>
        <button
          class="gallery-button gallery-button-left"
          type="button"
          aria-label="Previous Lurelia screenshot"
          data-gallery-previous
        >
          <img src="/img/icons/right.svg" alt="" aria-hidden="true" />
        </button>

        <div class="gallery-track-container">
          <div class="gallery-track" data-gallery-track>
            {
              lureliaGalleryImages.map((image, index) => (
                <figure
                  class:list={[
                    "gallery-slide",
                    { "is-active": index === 0 },
                  ]}
                >
                  <img
                    src={image.src}
                    alt={image.alt}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </figure>
              ))
            }
          </div>
        </div>

        <button
          class="gallery-button gallery-button-right"
          type="button"
          aria-label="Next Lurelia screenshot"
          data-gallery-next
        >
          <img src="/img/icons/right.svg" alt="" aria-hidden="true" />
        </button>

        <div class="gallery-meta" aria-live="polite">
          <span data-gallery-count>
            1 / {lureliaGalleryImages.length}
          </span>

          <div class="gallery-progress" aria-hidden="true">
            <span data-gallery-progress></span>
          </div>
        </div>
      </div>
    </section>
    */}

    <section
      class="feature-grid"
      id="features"
      aria-label="Lurelia features"
    >
      <article class="feature-card wide reveal">
        <p class="card-kicker">Routines</p>

        <h3>Turn the things you want to do into a system you can actually follow</h3>

        <p>
          Build routines from individual tasks, define how those tasks work,
          open full routine and task detail views, and run routines as active
          sessions. Lurelia keeps the structure visible while you are doing the
          routine instead of reducing everything to a generic checklist.
        </p>

        <div class="chip-row">
          <span>Routine Tasks</span>
          <span>Routine Runs</span>
          <span>Detailed Tasks</span>
          <span>Progress</span>
          <span>Live Activities</span>
        </div>
      </article>

      <article class="feature-card reveal">
        <p class="card-kicker">Routine Contracts</p>

        <h3>Give a routine meaning beyond completion</h3>

        <p>
          Build dedicated routine contracts that define the structure behind the
          routine you are creating. Lurelia gives routines room for intention,
          expectations, and the personal framework that makes following through
          meaningful.
        </p>
      </article>

      <article class="feature-card reveal">
        <p class="card-kicker">Active Routine</p>

        <h3>Stay connected to what you are doing right now</h3>

        <p>
          When a routine is running, Lurelia keeps that active state available
          from the main app experience so you can return to it without hunting
          through your library. Routine progress can also extend beyond the app
          through Live Activity support.
        </p>
      </article>

      <article class="feature-card reveal">
        <p class="card-kicker">Habits</p>

        <h3>Build habits with more context than a streak counter</h3>

        <p>
          Create habits, track completion, review history, and open a dedicated
          blueprint for the structure behind each habit. Lurelia treats a habit
          as something you build deliberately rather than a box you mindlessly
          tap once a day.
        </p>
      </article>

      <article class="feature-card reveal">
        <p class="card-kicker">Habit History</p>

        <h3>Look backward without losing sight of what comes next</h3>

        <p>
          Review previous habit activity and completion history from dedicated
          history views while keeping current habits connected to the rest of
          your daily system.
        </p>
      </article>

      <article class="feature-card wide reveal">
        <p class="card-kicker">Timeline</p>

        <h3>See the shape of your day instead of another endless task list</h3>

        <p>
          Lurelia's timeline brings scheduled work into a time-based view so you
          can understand what your day actually looks like. Routine tasks can be
          organized alongside the rest of your schedule, giving you a clearer
          sense of sequence, timing, and available space.
        </p>

        <div class="timeline-preview">
          <div class="timeline-row">
            <span class="timeline-time">8:00</span>

            <div class="timeline-task">
              <strong>Morning Routine</strong>
              <small>Start the day intentionally</small>
            </div>
          </div>

          <div class="timeline-row">
            <span class="timeline-time">12:30</span>

            <div class="timeline-task">
              <strong>Reminder</strong>
              <small>Something important is due</small>
            </div>
          </div>

          <div class="timeline-row">
            <span class="timeline-time">7:00</span>

            <div class="timeline-task">
              <strong>Evening Flow</strong>
              <small>Reset before the day ends</small>
            </div>
          </div>
        </div>
      </article>

      <article class="feature-card reveal">
        <p class="card-kicker">Kanban</p>

        <h3>Organize routine work visually</h3>

        <p>
          Create a Kanban structure around your routine tasks and move through
          work from a visual board. Lurelia also includes a timeline-based
          Kanban experience for seeing scheduled cards in relation to time.
        </p>
      </article>

      <article class="feature-card reveal">
        <p class="card-kicker">Time Blocks</p>

        <h3>Give parts of your day actual space</h3>

        <p>
          Use schedule and time-blocking tools to build a clearer plan for when
          things happen instead of relying only on due dates and notifications.
        </p>
      </article>

      <article class="feature-card wide reveal">
        <p class="card-kicker">Reminders</p>

        <h3>Keep important things visible before they become forgotten things</h3>

        <p>
          Create detailed reminders, open dedicated reminder detail pages, track
          reminder history, and complete supported reminders directly from
          Lurelia's interactive widgets. Reminders remain part of the same
          system as your routines, habits, events, and schedule.
        </p>

        <div class="chip-row">
          <span>Due Reminders</span>
          <span>Reminder Details</span>
          <span>History</span>
          <span>Notifications</span>
          <span>Interactive Widgets</span>
        </div>
      </article>

      <article class="feature-card reveal">
        <p class="card-kicker">Events</p>

        <h3>Bring your calendar into the same place as your plans</h3>

        <p>
          Create and manage Lurelia events through dedicated calendar, agenda,
          event detail, and scheduling views. Event support also integrates with
          Apple Calendar so your calendar life does not need to exist separately
          from everything else you are planning.
        </p>
      </article>

      <article class="feature-card reveal">
        <p class="card-kicker">Calendar Views</p>

        <h3>Switch between dates and details without losing context</h3>

        <p>
          Move through month and agenda-style calendar experiences, inspect
          individual event occurrences, manage calendars, and work with both
          Lurelia events and supported Apple Calendar information.
        </p>
      </article>
    </section>

    <section class="spotlight reveal">
      <div class="spotlight-copy">
        <p class="eyebrow">Shared Events</p>

        <h2>Plan something that exists beyond your own calendar</h2>

        <p>
          Lurelia's shared events are built for experiences involving other
          people. Create an event, share access, manage the event as its host,
          publish updates and posts, participate in comments, work with
          attachments, and keep shared event information connected to calendar
          tools.
        </p>
      </div>

      <div class="share-demo" aria-label="Lurelia shared event preview">
        <span class="share-pill">Shared Event</span>

        <h4>Bring people into the plan.</h4>

        <div class="share-row">
          <span>Event</span>
          <strong>Created and organized</strong>
        </div>

        <div class="share-row">
          <span>Updates</span>
          <strong>Posts from the host</strong>
        </div>

        <div class="share-row">
          <span>Conversation</span>
          <strong>Comments and attachments</strong>
        </div>
      </div>
    </section>

    <section class="feature-grid secondary-grid">
      <article class="feature-card wide reveal">
        <p class="card-kicker">Journeys</p>

        <h3>Turn a bigger direction into milestones you can keep moving through</h3>

        <p>
          Journeys give longer-term goals and personal changes somewhere to
          live. Create a journey around a vision, break it into milestones and
          individual steps, follow progress, add notes, and see the path unfold
          through a dedicated timeline.
        </p>

        <div class="journey-preview">
          <div class="journey-progress-label">
            <span>Journey Progress</span>
            <strong>58%</strong>
          </div>

          <div class="journey-dots" aria-hidden="true">
            <span class="complete"></span>
            <span class="complete"></span>
            <span class="complete"></span>
            <span class="complete"></span>
            <span class="complete"></span>
            <span class="complete"></span>
            <span class="complete"></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>

          <div class="journey-info">
            <span>
              <small>Current Milestone</small>
              <strong>Build the Foundation</strong>
            </span>

            <span>
              <small>Next Step</small>
              <strong>Continue Forward</strong>
            </span>
          </div>
        </div>
      </article>

      <article class="feature-card reveal">
        <p class="card-kicker">Milestones</p>

        <h3>Break a long path into meaningful markers</h3>

        <p>
          Give each Journey milestones that represent real stages of progress,
          then work through individual steps without losing sight of the larger
          direction.
        </p>
      </article>

      <article class="feature-card reveal">
        <p class="card-kicker">Journey Notes</p>

        <h3>Keep the story behind your progress</h3>

        <p>
          Add notes throughout a Journey so decisions, reflections, discoveries,
          and changes in direction can stay attached to the path they belong to.
        </p>
      </article>
    </section>

    <section class="details-section reveal">
      <div class="section-heading">
        <p class="eyebrow">Everything Working Together</p>

        <h2>Open up the deeper parts of Lurelia</h2>
      </div>

      <div class="details-list">
        <details open>
          <summary>
            <span>
              <b>Routine Task Details</b>
              <small>Build tasks with the context they actually need</small>
            </span>
          </summary>

          <p>
            Routine tasks have their own dedicated editor and detail
            experiences, allowing individual actions inside a routine to carry
            far more structure than a simple task title. That means your routine
            can explain what needs to happen instead of forcing you to remember
            all of the details every time.
          </p>
        </details>

        <details>
          <summary>
            <span>
              <b>Routine Notifications</b>
              <small>Bring the routine back to your attention when it matters</small>
            </span>
          </summary>

          <p>
            Lurelia supports notification-driven routine workflows so scheduled
            tasks and routines can reach outside the app instead of depending on
            you remembering to open it first.
          </p>
        </details>

        <details>
          <summary>
            <span>
              <b>Live Routine Progress</b>
              <small>Keep an active routine close while you complete it</small>
            </span>
          </summary>

          <p>
            Active routines can remain visible through Lurelia's running-routine
            interface and Live Activity infrastructure, making it easier to
            return to the routine currently in progress.
          </p>
        </details>

        <details>
          <summary>
            <span>
              <b>Kanban Board & Timeline</b>
              <small>Two visual ways to understand scheduled work</small>
            </span>
          </summary>

          <p>
            Lurelia includes both a Kanban board and a dedicated Kanban timeline.
            Use the board to organize work by column and the timeline to
            understand those cards in relation to time and the rest of your day.
          </p>
        </details>

        <details>
          <summary>
            <span>
              <b>Apple Calendar Integration</b>
              <small>Keep existing events connected to your Lurelia schedule</small>
            </span>
          </summary>

          <p>
            Calendar tools include dedicated handling for Apple Calendar events,
            event details, calendar settings, event occurrences, and scheduling
            so Lurelia can work alongside the calendar already used on your
            device.
          </p>
        </details>

        <details>
          <summary>
            <span>
              <b>Shared Event Hosting</b>
              <small>Create, manage, communicate, and keep attendees informed</small>
            </span>
          </summary>

          <p>
            Shared events include dedicated host-management tools alongside
            event editing, share tools, calendar synchronization, posts,
            comments, and attachment support. They are designed to function as
            living event spaces rather than static calendar entries.
          </p>
        </details>

        <details>
          <summary>
            <span>
              <b>Interactive Widgets</b>
              <small>Complete things without opening the full app</small>
            </span>
          </summary>

          <p>
            Lurelia includes widgets for routines, routine tasks, reminders,
            habits, the Kanban timeline, upcoming events, and other supported
            content. Interactive intents allow supported routine tasks,
            reminders, habits, and routines to be completed directly from
            widgets.
          </p>
        </details>

        <details>
          <summary>
            <span>
              <b>Release Notes</b>
              <small>See what changed when Lurelia evolves</small>
            </span>
          </summary>

          <p>
            Lurelia includes an in-app release notes experience that can surface
            new changes from the main app flow so updates are explained inside
            the product rather than existing only in an external changelog.
          </p>
        </details>
      </div>
    </section>

    <section class="community-banner reveal">
      <div>
        <p class="eyebrow">Built Around Real Days</p>

        <h2>Structure should support your life, not become another thing to manage.</h2>

        <p>
          Lurelia is built around the idea that routines, reminders, habits,
          events, and longer goals affect each other. It gives each one its own
          depth while keeping them connected inside one system, so structure can
          help you move through the day instead of turning the day into a pile
          of unrelated lists.
        </p>
      </div>

      <a class="primary-button raised-button" href="/github">
        Join the Community
      </a>
    </section>

    <section class="cta-section reveal">
      <p class="eyebrow">Explore Lurelia</p>

      <h2>Build the structure that helps you keep becoming who you mean to be.</h2>

      <p>
        Learn more about Lurelia, report a problem, share an idea, or reach out
        through Voxiverse Support.
      </p>

      <div class="cta-grid">
        <a
          href="https://github.com/asteriasmoons/Lurelia/issues"
          class="cta-card"
        >
          <span class="cta-kicker">Report an Issue</span>

          <h2>Lurelia Bug Reports</h2>

          <span class="cta-button">Open Reports</span>
        </a>

        <a href="/github" class="cta-card">
          <span class="cta-kicker">Ideas & Discussions</span>

          <h2>Voxiverse on GitHub</h2>

          <span class="cta-button">Open GitHub</span>
        </a>

        <a href="/contact" class="cta-card">
          <span class="cta-kicker">Need Help?</span>

          <h2>Contact Support</h2>

          <span class="cta-button">Get Support</span>
        </a>
      </div>
    </section>
  </main>
</DocsLayout>

<script>
  const revealItems = document.querySelectorAll(".reveal");

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  revealItems.forEach((item) => revealObserver.observe(item));

