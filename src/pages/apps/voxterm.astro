<section
  class="voxterm-gallery-section reveal"
  aria-labelledby="voxterm-gallery-title"
>
  <div class="section-heading gallery-heading">
    <p class="eyebrow">Your Day in VoxTerm</p>

    <h2 id="voxterm-gallery-title">
      Swipe through your personal planning system
    </h2>
  </div>

