---
import DocsLayout from "../../layouts/DocsLayout.astro";
import GradientDivider from "../../components/GradientDivider.astro";

/*
const voxtermGalleryImages = [
  "IMG_0001.PNG",
  "IMG_0002.PNG",
  "IMG_0003.PNG",
  "IMG_0004.PNG",
  "IMG_0005.PNG",
  "IMG_0006.PNG",
  "IMG_0007.PNG",
  "IMG_0008.PNG",
].map((fileName, index) => ({
  alt: `VoxTerm app screenshot ${index + 1}`,
  src: `/img/voxterm/${fileName}`,
}));
*/
---

<DocsLayout
  title="VoxTerm"
  description="Connect to SSH hosts, manage terminal sessions, organize projects, browse remote files, and keep your development workflow close with VoxTerm."
>
  <main class="voxterm-page">
    <section class="hero">
      <div class="hero-copy reveal">
        <p class="eyebrow">Meet VoxTerm</p>

        <h1>Connect, code, and manage your terminal workflow from one place.</h1>

        <p class="hero-text">
          VoxTerm is a mobile terminal and project workspace built for development
          away from your desk. Save SSH hosts, open and restore multiple terminal
          sessions, organize recurring work into projects, run saved commands,
          browse remote files over SFTP, and keep your development flow moving
          without rebuilding your setup every time.
        </p>

        <div class="hero-actions" aria-label="VoxTerm links">
          <a class="primary-button raised-button" href="#features">
            Explore Features
          </a>

          <a class="secondary-button raised-button" href="/contact">
            Contact Support
          </a>
        </div>
      </div>

      <div class="hero-showcase reveal reveal-delay">
        <div class="showcase-card main-card">
          <span class="mini-label">Your Workspace in VoxTerm</span>

          <h4>Your terminal, hosts, and projects together.</h4>

          <div class="progress-line">
            <span></span>
          </div>

          <div class="showcase-stats">
            <span><b>SSH</b> hosts</span>
            <span><b>Live</b> sessions</span>
            <span><b>Saved</b> projects</span>
          </div>
        </div>

        <div class="floating-card floating-card-one">
          <span>Active Session</span>
          <strong>Your terminal stays ready</strong>
        </div>

        <div class="floating-card floating-card-two">
          <span>Remote Files</span>
          <strong>SFTP browser available</strong>
        </div>
      </div>
    </section>

    <GradientDivider />

    <section class="intro-section reveal">
      <p class="eyebrow">One Connected Workspace</p>

      <h2>Your hosts, sessions, commands, and projects should not feel disconnected.</h2>

      <p>
        VoxTerm brings saved machines, live terminal sessions, reusable commands,
        projects, and remote file access into one development workspace. Instead
        of rebuilding context each time you connect, you can move between the
        machines and workspaces you return to while keeping that structure intact.
      </p>
    </section>

