---
import DocsLayout from "../../layouts/DocsLayout.astro";
import GradientDivider from "../../components/GradientDivider.astro";

/*
const voxtermGalleryImages = [
  "IMG_0001.PNG",
  "IMG_0002.PNG",
  "IMG_0003.PNG",
  "IMG_0004.PNG",
  "IMG_0005.PNG",
  "IMG_0006.PNG",
  "IMG_0007.PNG",
  "IMG_0008.PNG",
].map((fileName, index) => ({
  alt: `VoxTerm app screenshot ${index + 1}`,
  src: `/img/voxterm/${fileName}`,
}));
*/
---

<DocsLayout
  title="VoxTerm"
  description="Connect to SSH hosts, manage persistent terminal sessions, organize reusable projects and commands, browse and edit remote files, and customize your mobile development workspace with VoxTerm."
>
  <main class="voxterm-page">
    <section class="hero">
      <div class="hero-copy reveal">
        <p class="eyebrow">Meet VoxTerm</p>

        <h1>Take a real terminal workspace with you, not just a command prompt.</h1>

        <p class="hero-text">
          VoxTerm is a mobile terminal and remote development workspace built for
          the work that happens beyond a desk. Save SSH hosts, keep multiple
          terminal sessions alive, organize reusable projects and commands, replace
          command tokens at run time, browse and edit remote files over SFTP,
          and customize the terminal environment around the way you actually work.
        </p>

        <div class="hero-actions" aria-label="VoxTerm links">
          <a class="primary-button raised-button" href="#features">
            Explore Features
          </a>

          <a class="secondary-button raised-button" href="/contact">
            Contact Support
          </a>
        </div>
      </div>

      <div class="hero-showcase reveal reveal-delay">
        <div class="showcase-card main-card">
          <span class="mini-label">Your Remote Workspace</span>

          <h4>Sessions, projects, commands, and files stay connected.</h4>

          <div class="progress-line">
            <span></span>
          </div>

          <div class="showcase-stats">
            <span><b>SSH</b> connections</span>
            <span><b>Persistent</b> sessions</span>
            <span><b>Remote</b> editing</span>
          </div>
        </div>

        <div class="floating-card floating-card-one">
          <span>Active Sessions</span>
          <strong>Minimize, restore, and keep working</strong>
        </div>

        <div class="floating-card floating-card-two">
          <span>Remote Editor</span>
          <strong>Syntax-aware editing with auto-save</strong>
        </div>
      </div>
    </section>

    <GradientDivider />

    <section class="intro-section reveal">
      <p class="eyebrow">One Connected Workspace</p>

      <h2>Your terminal workflow should remember the context around every connection.</h2>

      <p>
        VoxTerm connects hosts, persistent sessions, reusable commands, project
        workspaces, remote files, and terminal preferences into one mobile
        development environment. The pieces you use repeatedly stay attached to
        the work they belong to instead of being rebuilt each time you reconnect.
      </p>
    </section>

