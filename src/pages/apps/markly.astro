  @media (min-width: 1400px) {
    .hero h1 {
      font-size: 4.75rem;
    }
  }

  .intro-section {
    max-width: 850px;
    padding: 4rem 0 2rem;
  }

  .intro-section h2,
  .gallery-heading h2,
  .spotlight h2,
  .details-section h2,
  .community-banner h2,
  .cta-section h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.05;
  }

  .markly-gallery-section {
    position: relative;
    padding: 2rem 0 3.25rem;
  }

  .gallery-heading {
    margin-bottom: 1.5rem;
  }

  .markly-gallery {
    position: relative;
    width: min(100%, 430px);
    margin: 0 auto;
    overflow: hidden;
    padding: 1rem 0 2.75rem;
