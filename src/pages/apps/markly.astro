---
import DocsLayout from "../../layouts/DocsLayout.astro";
import GradientDivider from "../../components/GradientDivider.astro";

/*
const marklyGalleryImages = [
  "IMG_0001.PNG",
  "IMG_0002.PNG",
  "IMG_0003.PNG",
  "IMG_0004.PNG",
  "IMG_0005.PNG",
  "IMG_0006.PNG",
  "IMG_0007.PNG",
  "IMG_0008.PNG",
].map((fileName, index) => ({
  alt: `Markly app screenshot ${index + 1}`,
  src: `/img/markly/${fileName}`,
}));
