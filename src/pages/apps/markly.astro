---
import DocsLayout from "../../layouts/DocsLayout.astro";
import GradientDivider from "../../components/GradientDivider.astro";

/*
const marklyGalleryImages = [
  "IMG_0001.PNG",
  "IMG_0002.PNG",
  "IMG_0003.PNG",
  "IMG_0004.PNG",
  "IMG_0005.PNG",
  "IMG_0006.PNG",
  "IMG_0007.PNG",
  "IMG_0008.PNG",
].map((fileName, index) => ({
  alt: `Markly app screenshot ${index + 1}`,
  src: `/img/markly/${fileName}`,
}));
*/
---

<DocsLayout
  title="Markly"
  description="Save, organize, read, annotate, pin, import, export, and rediscover the links that matter to you with Markly."
>
  <main class="markly-page">
    <section class="hero">
      <div class="hero-copy reveal">
        <p class="eyebrow">Meet Markly</p>

        <h1>Your corner of the internet, organized exactly the way you want it.</h1>

        <p class="hero-text">
          Markly is a personal bookmark and link-saving companion built to turn
          scattered links into an organized library you can actually use. Save
          anything worth keeping, organize it into folders and pin collections,
          add tags and notes, read articles without the clutter, and keep your
          entire library within reach across your devices.
        </p>

        <div class="hero-actions" aria-label="Markly links">
          <a class="primary-button raised-button" href="#features">
            Explore Features
          </a>

          <a class="secondary-button raised-button" href="/contact">
            Contact Support
          </a>
        </div>
      </div>

      <div class="hero-showcase reveal reveal-delay">
        <div class="showcase-card main-card">
          <span class="mini-label">Inside Markly</span>

          <h4>Save it now. Find it when it matters.</h4>

          <div class="progress-line">
            <span></span>
          </div>

          <div class="showcase-stats">
            <span><b>42</b> bookmarks</span>
            <span><b>8</b> folders</span>
            <span><b>6</b> collections</span>
          </div>
        </div>

        <div class="floating-card floating-card-one">
          <span>Quick Save</span>
          <strong>Shared directly to Markly</strong>
        </div>

        <div class="floating-card floating-card-two">
          <span>Reader Mode</span>
          <strong>Article ready to read</strong>
        </div>
      </div>
    </section>

    <GradientDivider />

    <section class="intro-section reveal">
      <p class="eyebrow">More Than Bookmarks</p>

      <h2>Saving a link should be the beginning, not the end.</h2>

      <p>
        Markly gives the things you save somewhere meaningful to live. Instead
        of letting useful links disappear into browser tabs, messages, notes,
        screenshots, and forgotten reading lists, Markly gives you a structured
        library with folders, collections, notes, tags, search, reader tools,
        previews, favorites, archives, and flexible ways to move your data in
        and out.
      </p>
    </section>

