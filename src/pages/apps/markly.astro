    display: block;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .floating-card strong {
    font-size: 0.92rem;
  }

  .floating-card-one {
    top: 0;
    right: 0;
  }

  .floating-card-two {
    bottom: 8px;
    left: 0;
    animation-delay: -2.4s;
  }

  @media (min-width: 901px) {
