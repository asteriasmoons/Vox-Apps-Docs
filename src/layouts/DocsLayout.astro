---
import BaseLayout from "./BaseLayout.astro";
import { getCollection } from "astro:content";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

const titleOverrides: Record<string, string> = {
  github: "GitHub",
  voxterm: "VoxTerm",
};

// Helper to clean up folder or file slugs into readable section titles
const formatTitle = (str: string) =>
  titleOverrides[str] ??
  str
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");

type NavItem = {
  title: string;
  href: string;
  isActive: boolean;
  isOpen: boolean;
  children: NavItem[];
};

type NavGroup = {
  section: string;
  items: NavItem[];
};

const currentCleanPath = currentPath.replace(/\/$/, "") || "/";

const createNode = (title: string, href: string): NavItem => {
  const cleanHref = href.replace(/\/$/, "") || "/";

  return {
    title,
    href,
    isActive: currentCleanPath === cleanHref,
    isOpen: currentCleanPath === cleanHref,
    children: [],
  };
};

const insertPath = (
  items: NavItem[],
  pathParts: string[],
  href: string,
  title: string,
) => {
  const [part, ...rest] = pathParts;
  if (!part) return;

  if (rest.length === 0) {
    const cleanHref = href.replace(/\/$/, "") || "/";
    const existing = items.find(
      (item) => item.href.replace(/\/$/, "") === cleanHref,
    );

    if (existing) {
      existing.title = title;
      existing.isActive = currentCleanPath === cleanHref;
      existing.isOpen = existing.isOpen || existing.isActive;
      return;
    }

    items.push(createNode(title, href));
    return;
  }

  let folder = items.find((item) => item.title === formatTitle(part));
  if (!folder) {
    folder = createNode(formatTitle(part), "#");
    items.push(folder);
  }

  insertPath(folder.children, rest, href, title);
  folder.isOpen =
    folder.children.some((child) => child.isActive || child.isOpen) ||
    folder.isOpen;
};

const groupedPagesMap: Record<string, NavItem[]> = {
  Overview: [createNode("Home", "/"), createNode("Contact", "/contact")],
};

// =========================================================
// 1. SOURCE ONE: CONTENT COLLECTION (MARKDOWN /DOCS)
// =========================================================
const docs = await getCollection("docs");

docs.forEach((doc) => {
  const href = `/docs/${doc.id}`;

  if (!groupedPagesMap.Docs) groupedPagesMap.Docs = [];

  insertPath(
    groupedPagesMap.Docs,
    doc.id.split("/"),
    href,
    doc.data.title || formatTitle(doc.id.split("/").pop() || ""),
  );
});

// =========================================================
// 2. SOURCE TWO: AUTOMATIC .ASTRO PAGES SCANNING
// =========================================================
const allPageFiles = import.meta.glob([
  "../pages/**/*.astro",
  "!../pages/api/**/*.astro",
  "!../pages/docs/[...slug].astro",
]);

Object.keys(allPageFiles).forEach((fileKey) => {
  // Extract route parts relative to src/pages/
  const pathParts = fileKey.replace("../pages/", "").split("/");
  const fileName = pathParts[pathParts.length - 1];

  if (fileName.startsWith("_") || fileName.includes("[")) return;

  const routeParts = pathParts.map((part) => part.replace(".astro", ""));
  const normalizedRouteParts =
    routeParts[routeParts.length - 1] === "index"
      ? routeParts.slice(0, -1)
      : routeParts;

  const routePath =
    normalizedRouteParts.length === 0
      ? "/"
      : `/${normalizedRouteParts.join("/")}`;

  if (routePath === "/" || routePath === "/contact") return;

  const [sectionSlug, ...childParts] = normalizedRouteParts;
  if (!sectionSlug) return;

  if (childParts.length === 0) {
    insertPath(
      groupedPagesMap.Overview,
      [sectionSlug],
      routePath,
      formatTitle(sectionSlug),
    );
    return;
  }

  const sectionName = formatTitle(sectionSlug);

  if (!groupedPagesMap[sectionName]) {
    groupedPagesMap[sectionName] = [];
  }

  insertPath(
    groupedPagesMap[sectionName],
    childParts,
    routePath,
    formatTitle(childParts[childParts.length - 1]),
  );
});

// =========================================================
// 3. SORTING ALL GROUPS ALPHABETICALLY
// =========================================================
const sortItems = (items: NavItem[]): NavItem[] =>
  items
    .sort((a, b) => a.title.localeCompare(b.title))
    .map((item) => ({
      ...item,
      children: sortItems(item.children),
    }));

const sectionOrder = ["Overview", "Docs", "Privacy"];

const groupedDocs: NavGroup[] = Object.entries(groupedPagesMap)
  .sort(([a], [b]) => a.localeCompare(b))
  .sort(([a], [b]) => {
    const aIndex = sectionOrder.indexOf(a);
    const bIndex = sectionOrder.indexOf(b);

    if (aIndex === -1 && bIndex === -1) return 0;
    if (aIndex === -1) return 1;
    if (bIndex === -1) return -1;

    return aIndex - bIndex;
  })
  .map(([section, items]) => ({
    section,
    items: sortItems(items),
  }));
---

<BaseLayout title={title} description={description}>
  <div class="docs-shell">
    {/* Backdrop for mobile */}
    <div class="docs-backdrop" data-sidebar-backdrop></div>

    {/* Sidebar */}
    <aside class="sidebar-drawer" data-sidebar-drawer>
      <div class="sidebar-top">
        <a href="/" class="sidebar-brand">
          <span class="sidebar-brand-icon">
            <img src="/favicon.svg" alt="Vox Apps" />
          </span>
          <span class="sidebar-brand-title">Vox Apps</span>
        </a>
        <button
          class="sidebar-close"
          aria-label="Close navigation"
          data-sidebar-close
        >
          <img src="/img/icons/close.svg" alt="Close" class="sidebar-icon" />
        </button>
      </div>

      <nav class="sidebar-nav">
        {
          groupedDocs.map(({ section, items }) => (
            <div class="nav-group">
              {section === "Overview" ? (
                <>
                  <p class="nav-section">{section}</p>
                  <ul class="nav-list">
                    {items.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          class:list={{
                            "nav-link": true,
                            "nav-link-active": item.isActive,
                          }}
                        >
                          <span class="nav-link-text">{item.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <ul class="nav-list">
                  <li class="nav-anchor-item">
                    <details
                      class="nav-anchor-details"
                      open={items.some((item) => item.isActive || item.isOpen)}
                    >
                      <summary
                        class:list={{
                          "nav-link": true,
                          "nav-link-active": items.some(
                            (item) => item.isActive || item.isOpen,
                          ),
                          "nav-anchor-summary": true,
                        }}
                      >
                        <span class="nav-link-text">{section}</span>
                        <span class="nav-anchor-chevron">
                          <img
                            src="/img/icons/right.svg"
                            class="chevron-icon chevron-right"
                            alt=""
                          />
                          <img
                            src="/img/icons/down.svg"
                            class="chevron-icon chevron-down"
                            alt=""
                          />
                        </span>
                      </summary>

                      <div class="nav-anchor-body">
                        {items.map((item) => {
                          if (item.children.length > 0) {
                            return (
                              <details
                                class="nav-anchor-details nav-nested-anchor-details"
                                open={item.isOpen}
                              >
                                <summary
                                  class:list={{
                                    "nav-sublink": true,
                                    "nav-sublink-active": item.isActive,
                                    "nav-anchor-summary": true,
                                    "nav-nested-summary": true,
                                  }}
                                >
                                  <span class="nav-link-text">{item.title}</span>
                                  <span class="nav-anchor-chevron">
                                    <img
                                      src="/img/icons/right.svg"
                                      class="chevron-icon chevron-right"
                                      alt=""
                                    />
                                    <img
                                      src="/img/icons/down.svg"
                                      class="chevron-icon chevron-down"
                                      alt=""
                                    />
                                  </span>
                                </summary>

                                <div class="nav-anchor-body nav-nested-anchor-body">
                                  {item.href !== "#" && (
                                    <a
                                      href={item.href}
                                      class:list={{
                                        "nav-sublink": true,
                                        "nav-sublink-active": item.isActive,
                                      }}
                                    >
                                      Overview
                                    </a>
                                  )}

                                  {item.children.map((child) => (
                                    <a
                                      href={child.href}
                                      class:list={{
                                        "nav-sublink": true,
                                        "nav-sublink-active": child.isActive,
                                      }}
                                    >
                                      {child.title}
                                    </a>
                                  ))}
                                </div>
                              </details>
                            );
                          }

                          return (
                            <a
                              href={item.href}
                              class:list={{
                                "nav-sublink": true,
                                "nav-sublink-active": item.isActive,
                              }}
                            >
                              {item.title}
                            </a>
                          );
                        })}
                      </div>
                    </details>
                  </li>
                </ul>
              )}
            </div>
          ))
        }
      </nav>
    </aside>

    {/* Main Layout Content wrapper */}
    <div class="docs-main">
      <header class="topbar">
        <div class="topbar-inner">
          <button
            class="sidebar-toggle"
            aria-label="Open navigation"
            data-sidebar-open
          >
            <img src="/img/icons/dotmenu.svg" alt="Menu" class="sidebar-icon" />
          </button>

          <span class="topbar-title">{title ?? "Documentation"}</span>
        </div>
      </header>

      <main class="content">
        <slot />
      </main>
    </div>
  </div>

  <script is:inline>
    if (typeof document !== "undefined") {
      const initSidebar = () => {
        const body = document.body;
        const openBtn = document.querySelector("[data-sidebar-open]");
        const closeBtn = document.querySelector("[data-sidebar-close]");
        const backdrop = document.querySelector("[data-sidebar-backdrop]");

        if (!openBtn || !closeBtn || !backdrop) return;

        const openSidebar = () => {
          body.classList.add("sidebar-open");
        };

        const closeSidebar = () => {
          body.classList.remove("sidebar-open");
        };

        openBtn.addEventListener("click", openSidebar);
        closeBtn.addEventListener("click", closeSidebar);
        backdrop.addEventListener("click", closeSidebar);

        window.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeSidebar();
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initSidebar);
      } else {
        initSidebar();
      }
    }
  </script>
</BaseLayout>
